    "predev": "node scripts/prepare-content.mjs",
    "prebuild": "node scripts/prepare-content.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "8.1.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
